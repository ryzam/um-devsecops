              "protocol": "HTTP",
              "isEncrypted": false,
              "isPublicNetwork": true,
              "hasOpenThreats": true,
              "threats": [
                {
                  "id": "13da4d8c-3556-5109-b025-553a8a232fe0",
                  "title": "SQL injection pada log masuk dan carian",
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "modelType": "STRIDE",
                  "description": "Input daripada /login dan /search digabung terus dalam query SQL. Penyerang menyuntik admin'-- untuk melepasi log masuk atau membaca jadual users.",
                  "mitigation": "Query berparameter. Hash kata laluan yang kuat (bukan MD5).",
                  "number": 1
                },
                {
                  "id": "aa2e7fa6-0968-5962-82ad-00348af52c45",
                  "title": "XSS pantulan dan tersimpan",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Tampering",
                  "modelType": "STRIDE",
                  "description": "Input dipaparkan semula tanpa encoding pada /search dan buku pelawat. Skrip penyerang berjalan dalam pelayar pengguna lain.",
                  "mitigation": "Output encoding. Content-Security-Policy. Token CSRF pada borang.",
                  "number": 2
                },
                {
                  "id": "a45517e9-8798-5d8b-b8a3-8067b4c278bd",
                  "title": "Tiada log pengarang buku pelawat",
                  "status": "Open",
                  "severity": "Low",
                  "type": "Repudiation",
                  "modelType": "STRIDE",
                  "description": "Tiada rekod siapa menulis entri dalam buku pelawat, jadi penyalahgunaan tidak dapat dikesan atau disangkal.",
                  "mitigation": "Log audit dengan identiti, masa dan alamat IP.",
                  "number": 3
                },
                {
                  "id": "2936c9a1-632a-5aaf-bee3-adfb9fac3806",
                  "title": "IDOR dan hash kata laluan didedahkan",
                  "status": "Open",
                  "severity": "High",
                  "type": "Information disclosure",
                  "modelType": "STRIDE",
                  "description": "/api/users/{id} memulangkan rekod pengguna lain termasuk hash MD5 kata laluan tanpa semakan kebenaran.",
                  "mitigation": "Semakan kebenaran pada setiap objek. Jangan pulangkan hash dalam API.",
                  "number": 8
                }
              ],
              "isTrustBoundary": false
